# Токен бота: Discord Developer Portal → ваше приложение → Bot → Reset Token
DISCORD_TOKEN=

# Префикс текстовых команд (слэш-команды работают всегда)
COMMAND_PREFIX=!

# ID сервера для мгновенной синхронизации слэш-команд при разработке.
# Оставьте пустым, чтобы синхронизировать глобально (до 1 часа).
DEV_GUILD_ID=

# Путь к ffmpeg, если он не найден в PATH (необязательно)
FFMPEG_PATH=

# Файл cookies.txt для YouTube (помогает при проверке «не бот» и возрастных ограничениях)
YTDL_COOKIES_FILE=

# Прокси для yt-dlp, например http://127.0.0.1:8080 (необязательно)
PROXY=

# Громкость по умолчанию, 0–200
DEFAULT_VOLUME=60

# Ограничения
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_ITEMS=100

# Через сколько секунд тишины бот выходит из канала (0 — не выходить)
IDLE_TIMEOUT=300

# Цвет эмбедов в формате 0xRRGGBB
EMBED_COLOR=0x5865F2

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
